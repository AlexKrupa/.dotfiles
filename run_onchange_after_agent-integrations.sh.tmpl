#!/bin/sh
# A skill link points to a folder. Only the integration files and the set of skill folders change
# the links.
# source hash: {{ output "sh" "-c" "cd \"$1\" && { find integrations -type f | sort | xargs shasum; find skills -mindepth 1 -maxdepth 2 -type d | sort; } | shasum" "sh" (joinPath .chezmoi.sourceDir "dot_config/agents") }}
for install in "$HOME"/.config/agents/integrations/*/install.sh; do
  "$install" || exit
done
