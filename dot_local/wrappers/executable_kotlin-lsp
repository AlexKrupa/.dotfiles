#!/bin/sh
# Connects an LSP client on stdin and stdout to one detached server per project root, so all
# clients share one index. The server reruns the Gradle import on every `initialize`, and a stdio
# server exits with its client. A detached server keeps the index warm for a later client.
# The cache in `~/Library/Caches/JetBrains/analyzer` is keyed by root path, so git worktrees of one
# repo need separate servers.
set -eu

host=127.0.0.1
server=/opt/homebrew/bin/kotlin-lsp
boot_timeout_seconds=300

# Each marker searches all parents before the next, so a module `build.gradle.kts` does not win
# over the repo `settings.gradle.kts`. Same order as `vim.fs.root` in `nvim/lua/plugins/lsp.lua`.
find_root() {
  for marker in settings.gradle.kts settings.gradle build.gradle.kts build.gradle; do
    directory=$PWD
    while [ "$directory" != / ]; do
      if [ -e "$directory/$marker" ]; then
        echo "$directory"
        return
      fi
      directory=$(dirname "$directory")
    done
  done
  return 1
}

root=$(find_root) || {
  echo "kotlin-lsp: no Gradle root above $PWD" >&2
  exit 1
}
key=$(printf %s "$root" | shasum -a 256 | cut -c1-12)
port=$((20000 + 0x${key%????????} % 20000))
system_path=$HOME/.cache/kotlin-lsp/$key
log_path=$system_path/stdout.log

if ! nc -z "$host" "$port" 2>/dev/null; then
  mkdir -p "$system_path"
  # AGP 9 fails to create the Compose Preview task of a variant with no unit tests, and the import
  # creates every task. Builds outside the server keep the default, so their unit test tasks do
  # less work. `export` cannot set a name with a dot.
  (
    cd "$root"
    env 'ORG_GRADLE_PROJECT_android.onlyEnableUnitTestForTheTestedBuildType=false' \
      nohup "$server" --socket "$host:$port" --multi-client --system-path "$system_path" \
      >>"$log_path" 2>&1 </dev/null &
  )
  waited_seconds=0
  until nc -z "$host" "$port" 2>/dev/null; do
    if [ "$waited_seconds" -ge "$boot_timeout_seconds" ]; then
      echo "kotlin-lsp: no server on $host:$port for $root after ${boot_timeout_seconds}s, see $log_path" >&2
      exit 1
    fi
    sleep 1
    waited_seconds=$((waited_seconds + 1))
  done
fi

exec nc "$host" "$port"
