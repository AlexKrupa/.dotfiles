{{- $dotfilesEditable := promptBoolOnce . "dotfilesEditable" "Can you edit dotfiles on this machine?" -}}
[data]
dotfilesEditable = {{ $dotfilesEditable }}

[git]
autoCommit = true
autoPush = true

[diff]
# Show live target edits as additions. `chezmoi apply --interactive` ignores this.
reverse = true
