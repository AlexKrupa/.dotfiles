{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "env": {
    "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN": "0",
    "CLAUDE_CODE_DISABLE_AUTO_UPDATE": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_NO_FLICKER": "0",
    "CLAUDE_CODE_THRIFTY_SONIC": "0",
    "DISABLE_AUTOUPDATER": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(~/.claude/skills/review-branch/branch-context.sh:*)",
      "Bash(~/.claude/skills/review-branch/report-path.sh:*)",
      "Bash(~/.claude/skills/review-me/absorb-fixes.sh:*)",
      "Bash(~/.claude/skills/debug-gitlab/gitlab.sh:*)",
      "Bash(~/.claude/skills/review-gitlab/fetch-mr.sh:*)",
      "Bash(~/.config/ai/bin/repo-slug.sh)",
      "Bash(./gradlew *)",
      "Bash(adb *)",
      "Bash(brew list:*)",
      "Bash(build-brief *)",
      "Bash(cat *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(env)",
      "Bash(fd *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(git blame *)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git stash list)",
      "Bash(git status *)",
      "Bash(git tag *)",
      "Bash(git-spice branch:*)",
      "Bash(git-spice log:*)",
      "Bash(glab mr checkout:*)",
      "Bash(glab mr diff:*)",
      "Bash(glab mr view:*)",
      "Bash(grep *)",
      "Bash(gs branch:*)",
      "Bash(gs log:*)",
      "Bash(head *)",
      "Bash(ksrc *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(rg *)",
      "Bash(tail *)",
      "Bash(tmux display-message:*)",
      "Bash(tmux list-panes:*)",
      "Bash(unzip * ~/.gradle/caches/*)",
      "Bash(wc *)",
      "Bash(which *)",
      "Edit(~/.ai/*)",
      "LSP",
      "Read(~/.ai/*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "mcp__claude_ai_Context7__query-docs",
      "mcp__claude_ai_Context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id"
    ],
    "deny": [
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git clean -f *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/build/**)",
      "Edit(**/generated/**)"
    ],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "fallbackModel": [
    "claude-opus-4-8",
    "claude-opus-4-7",
    "claude-opus-4-6[1m]"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/alexkrupa/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/alexkrupa/.claude/hooks/append-terse.sh'"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableArtifact": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 5,
    "hideVimModeIndicator": true
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash ~/.claude/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "jdtls-lsp@claude-plugins-official": false,
    "kotlin-lsp@claude-plugins-official": false,
    "ksrc@respawn-tools": false,
    "lua-lsp@claude-plugins-official": false,
    "ponytail@ponytail": true,
    "pyright-lsp@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "simple-english@simple-english": true,
    "superpowers@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "nono@nolabs-ai": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "respawn-tools": {
      "source": {
        "source": "github",
        "repo": "respawn-app/claude-plugin-marketplace"
      }
    },
    "simple-english": {
      "source": {
        "source": "github",
        "repo": "AminBlg/SimpleEnglish"
      }
    }
  },
  "outputStyle": "Plain",
  "sandbox": {
    "enabled": false,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "*.gradle.com",
        "*.githubusercontent.com",
        "*.gradle.org",
        "*.maven.org",
        "*.npmjs.org",
        "*.sonatype.org",
        "api.adoptium.net",
        "api.foojay.io",
        "api.github.com",
        "central.sonatype.com",
        "crates.io",
        "dl.google.com",
        "download.jetbrains.com",
        "github.com",
        "gitlab.com",
        "index.crates.io",
        "jitpack.io",
        "maven.google.com",
        "registry.npmjs.org",
        "repo.maven.apache.org",
        "services.gradle.org",
        "static.crates.io"
      ],
      "strictAllowlist": true,
      "allowUnixSockets": [
        "/private/tmp/tmux-501/default",
        "~/.config/herdr/herdr.sock"
      ],
      "allowLocalBinding": true,
      "allowMachLookup": [
        "com.apple.trustd.agent",
        "com.apple.FSEvents"
      ]
    },
    "filesystem": {
      "allowWrite": [
        ".",
        "~/.ai",
        "~/.android",
        "~/.cache",
        "~/.cargo",
        "~/.emulator_console_auth_token",
        "~/.gradle",
        "~/.m2",
        "~/.npm",
        "~/Library/Android/sdk"
      ],
      "allowRead": [
        "."
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.mitmproxy",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        }
      ]
    }
  },
  "feedbackDrafts": "off",
  "syntaxHighlightingDisabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5": {
      "effortLevel": "low"
    }
  },
  "showClearContextOnPlanAccept": true,
  "prefersReducedMotion": false,
  "showThinkingSummaries": true,
  "theme": "auto",
  "editorMode": "normal",
  "preferredNotifChannel": "notifications_disabled",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoConnectIde": false
}
