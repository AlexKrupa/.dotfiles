{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "env": {
    "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN": "0",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_PROMPT_CACHE_TTL": "1h",
    "DISABLE_AUTOUPDATER": "1",
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/unwrap-paste:~/.claude/mods/md-prompt"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(~/.config/agents/bin/repo-slug.sh)",
      "Bash(./gradlew *)",
      "Bash(brew list:*)",
      "Bash(cat *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(fd *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(git blame *)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git stash list)",
      "Bash(git status *)",
      "Bash(git tag *)",
      "Bash(git-spice log:*)",
      "Bash(glab mr checkout:*)",
      "Bash(glab mr diff:*)",
      "Bash(glab mr view:*)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ksrc *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(rg *)",
      "Bash(tail *)",
      "Bash(unzip * ~/.gradle/caches/*)",
      "Bash(wc *)",
      "Bash(which *)",
      "Read(~/.ai/**)",
      "Edit(~/.ai/**)",
      "LSP",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "mcp__claude_ai_Context7__query-docs",
      "mcp__claude_ai_Context7__resolve-library-id",
      "mcp__plugin_ksrc_ksrc__search",
      "mcp__plugin_ksrc_ksrc__cat",
      "mcp__plugin_ksrc_ksrc__deps",
      "Bash(git-spice branch checkout:*)",
      "Bash(git-spice branch create:*)",
      "Bash(git-spice branch track:*)",
      "Bash(git-spice branch rename:*)",
      "Bash(git-spice branch squash:*)",
      "Bash(git-spice branch split:*)",
      "Bash(git-spice branch restack:*)",
      "Bash(git-spice branch onto:*)",
      "Bash(git-spice branch diff:*)",
      "Bash(git-spice branch submit --update-only:*)",
      "Bash(git-spice branch submit --no-publish:*)",
      "Bash(git-spice commit:*)",
      "Bash(git-spice upstack restack:*)",
      "Bash(git-spice upstack onto:*)",
      "Bash(git-spice downstack track:*)",
      "Bash(git-spice downstack restack:*)",
      "Bash(git-spice stack restack:*)",
      "Bash(git-spice up:*)",
      "Bash(git-spice down:*)",
      "Bash(git-spice top:*)",
      "Bash(git-spice bottom:*)",
      "Bash(git-spice trunk:*)",
      "Bash(git-spice rebase:*)"
    ],
    "deny": [
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git clean -f *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/id_ed25519)",
      "Read(~/.gnupg/private-keys-v1.d/**)"
    ],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "fallbackModel": [
    "claude-opus-5",
    "claude-opus-4-8",
    "claude-opus-4-7",
    "claude-opus-4-6[1m]"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-edit.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/alexkrupa/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableArtifact": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 5,
    "hideVimModeIndicator": true
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash ~/.claude/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "android-cli@android-cli-plugin": false,
    "cc-plugin-telemetry@builtin": false,
    "clangd-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "context7@claude-plugins-official": false,
    "cowork-plugin-management@synced": false,
    "gopls-lsp@claude-plugins-official": false,
    "jdtls-lsp@claude-plugins-official": false,
    "kotlin-lsp@claude-plugins-official": false,
    "ksrc@local-pins": true,
    "ksrc@respawn-tools": false,
    "lua-lsp@claude-plugins-official": false,
    "nono@nolabs-ai": false,
    "pyright-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "simple-english@simple-english": true,
    "skill-creator@claude-plugins-official": true,
    "skins@local-pins": true,
    "superpowers@local-pins": true,
    "swift-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "watchd@local-pins": true
  },
  "extraKnownMarketplaces": {
    "simple-english": {
      "source": {
        "source": "github",
        "repo": "AminBlg/SimpleEnglish"
      }
    },
    "local-pins": {
      "source": {
        "source": "directory",
        "path": "/Users/alexkrupa/.claude/local-marketplace"
      }
    },
    "respawn-tools": {
      "source": {
        "source": "github",
        "repo": "respawn-app/claude-plugin-marketplace"
      }
    },
    "android-cli-plugin": {
      "source": {
        "source": "github",
        "repo": "android/android-cli-plugin"
      }
    }
  },
  "outputStyle": "Brief",
  "feedbackDrafts": "off",
  "syntaxHighlightingDisabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "prefersReducedMotion": false,
  "showThinkingSummaries": true,
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "notifications_disabled",
  "idleCompaction": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoConnectIde": false
}
