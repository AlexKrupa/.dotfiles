#!/bin/sh
# Even the column group a pluck editor pane leaves behind. Nothing inside that pane
# outlives its close, so the first call re-runs itself detached and the detached copy
# waits for the pane to go.
#
# Usage: pluck-post-close <tab-id> <surviving-pane-id> <closing-pane-id>
[ $# -eq 3 ] || exit 2

if [ -z "${PLUCK_POST_CLOSE_BG:-}" ]; then
  PLUCK_POST_CLOSE_BG=1 nohup "$0" "$@" >/dev/null 2>&1 &
  exit 0
fi

# 2s at most. A pane still there after that is not closing, and evening the group while
# it lives only sets the ratios the split already made.
i=0
while herdr pane get "$3" >/dev/null 2>&1; do
  i=$((i + 1))
  [ "$i" -lt 40 ] || exit 0
  sleep 0.05
done

HERDR_ACTIVE_TAB_ID=$1 HERDR_ACTIVE_PANE_ID=$2 \
  exec "$(dirname "$0")/balance-panes.sh" equalize right
