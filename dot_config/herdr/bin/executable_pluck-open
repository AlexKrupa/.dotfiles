#!/usr/bin/env bash
# herdr-pluck open action. pluck pipes the match on stdin and runs this in the source
# pane's cwd, so relative paths resolve.

set -euo pipefail

bin=$(cd "$(dirname "$0")" && pwd)

match=$(cat)
[ -z "$match" ] && exit 0

case "$match" in
  "~"|"~/"*) match="$HOME${match#\~}" ;;
esac
[ -e "$match" ] || [ ! -e "$HOME/$match" ] || match="$HOME/$match"

if [ -f "$match" ]; then
  # SVG is XML (text) but usually wanted as a preview, not an edit.
  case "$match" in
    *.svg|*.SVG) exec open "$match" ;;
  esac
  enc=$(file -b --mime-encoding -- "$match" 2>/dev/null || echo binary)
  [ "$enc" != "binary" ] || exec open "$match"
  # open-link is the Ctrl+click handler. It takes its input from these env vars and
  # rejects a bare filename, hence the absolute path.
  match="$(cd "$(dirname "$match")" && pwd)/$(basename "$match")"
  nvim_plugin=$(ls -d "$HOME"/.config/herdr/plugins/github/chmarax.herdr-nvim-*/ | head -1)
  HERDR_PLUGIN_CLICKED_URL="$match" HERDR_PANE_ID="$HERDR_PLUCK_PANE_ID" \
    HERDR_TAB_ID="$HERDR_PLUCK_TAB_ID" HERDR_WORKSPACE_ID="${HERDR_PLUCK_TAB_ID%%:*}" \
    exec "$nvim_plugin/bin/herdr-nvim" open-link
fi

if [ -d "$match" ]; then
  # The picker tab is still focused here, so the source pane is named explicitly. equalize
  # takes its tab and pane from the environment, the same as the split key.
  pane=$(herdr pane split --pane "$HERDR_PLUCK_PANE_ID" --direction right --cwd "$match" \
    --focus | jq -r .result.pane.pane_id)
  HERDR_ACTIVE_TAB_ID="$HERDR_PLUCK_TAB_ID" HERDR_ACTIVE_PANE_ID="$pane" \
    "$bin/balance-panes.sh" equalize right
  # `y` is the fish wrapper from conf.d/yazi.fish: on quit the pane shell stays in the
  # directory yazi ended in. This pane is closed by key, and the close key evens what is left.
  exec herdr pane run "$pane" y
fi

exec open "$match"
