#!/bin/sh
# Close the active pane and even out the group it leaves behind. Replaces the
# built-in close_pane action, which is unset in config.toml: the close collapses
# a split, and the direction of that split and the pane on its other side have
# to be read before they go away. A keybinding runs one command, so the pair
# lives here.
#
# `(a | b) | c` closing `b` leaves `a | c` at the 2:1 ratio the three columns
# had, and this puts it back to 1:1. Closing a pane out of `a | (b / c)`
# collapses a row split into a column with no row group left, so nothing moves.
[ -n "$HERDR_ACTIVE_PANE_ID" ] || exit 0

bin=$(dirname "$0")
command -v jq >/dev/null || exec herdr pane close "$HERDR_ACTIVE_PANE_ID"

# `<direction> <path>`, or nothing when the pane is the whole tab. Cleared first
# so the count below never reads arguments this script was called with.
set --
if [ -n "$HERDR_ACTIVE_TAB_ID" ]; then
  set -- $("$bin/herdr-rpc" layout.export "{\"tab_id\":\"$HERDR_ACTIVE_TAB_ID\"}" |
    jq -r -L "$bin" --arg pane "$HERDR_ACTIVE_PANE_ID" 'include "layout"; close_target($pane)')
fi

herdr pane close "$HERDR_ACTIVE_PANE_ID" >/dev/null || exit 1
[ $# -eq 2 ] || exit 0
exec "$bin/equalize-panes" "$1" "$2"
