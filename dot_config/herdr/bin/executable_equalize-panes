#!/usr/bin/env fish
# Give every pane in the current tab an equal share. The herdr CLI exposes no
# layout subcommand, so this goes over the socket.
#
# A split ratio of 0.5 everywhere does not equalize panes. For `a | (b | c)` it
# gives 50/25/25. Each split is weighted by how many panes sit on each side, so
# the root above becomes 1/3 and the inner one 1/2. That gives 33/33/33.
#
# `path` is an array of booleans (API schema: LayoutSetSplitRatioParams):
# false selects `first`, true selects `second`. The root split is [].
# layout.apply would do this in one call but takes a whole tree and can
# recreate panes, which would kill running agents. set_split_ratio only
# changes a ratio.
#
# Exact for a tab split all one direction. For mixed directions, ratios alone
# cannot give equal area. This makes the same approximation as tmux's
# `select-layout tiled`.

set -l rpc (status dirname)/herdr-rpc
command -v jq >/dev/null; or exit 0

# Target the pressing pane. `--current` ignores HERDR_ACTIVE_PANE_ID and falls
# back to whichever pane the UI has focused, which is the wrong tab as soon as a
# second client is attached.
set -l target --current
test -n "$HERDR_ACTIVE_PANE_ID"; and set target --pane $HERDR_ACTIVE_PANE_ID

set -l tab (herdr pane layout $target 2>/dev/null \
  | jq -r '[.. | objects | .tab_id? // empty] | first // empty')
test -n "$tab"; or exit 0

# One {path, ratio} per split, ratio = panes on the first side / panes in total.
set -l splits ($rpc layout.export "{\"tab_id\":\"$tab\"}" | jq -c '
  def leaves: if .type == "split" then (.first | leaves) + (.second | leaves) else 1 end;
  def walk($p):
    if type == "object" and .type == "split" then
      {path: $p, ratio: ((.first | leaves) / leaves)},
      (.first  | walk($p + [false])),
      (.second | walk($p + [true]))
    else empty end;
  [.. | objects | select(has("root")) | .root] | first | [walk([])] | .[]
')

for s in $splits
  set -l path (printf '%s' $s | jq -c '.path')
  set -l ratio (printf '%s' $s | jq -r '.ratio')
  $rpc layout.set_split_ratio "{\"tab_id\":\"$tab\",\"path\":$path,\"ratio\":$ratio}" >/dev/null
end
