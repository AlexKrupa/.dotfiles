#!/bin/sh
# Give every pane in the current tab an equal share, or with `right` or `down`
# only the row or column group the active pane sits in - what the split and
# close keys use. bin/layout.jq picks the splits and works out the ratios.
#
# The herdr CLI exposes no layout subcommand, so this goes over the socket.
# layout.apply would set every ratio in one call but takes a whole tree and can
# recreate panes, which would kill running agents. set_split_ratio only changes
# a ratio.
#
# POSIX sh, not fish: this is key-bound, and fish spends ~110ms sourcing
# config.fish per process - once here plus once per herdr-rpc call.
#
# Pane *areas* are only equal when the whole tab splits one direction; ratios
# alone cannot do better on a mixed tree without restructuring it.

case ${1:-} in
  '' | right | down) dir=${1:-} ;;
  *) echo "usage: equalize-panes [right|down]" >&2; exit 2 ;;
esac

bin=$(dirname "$0")
command -v jq >/dev/null || exit 0

# Target the pressing pane. `--current` ignores HERDR_ACTIVE_PANE_ID and falls
# back to whichever pane the UI has focused, which is the wrong tab as soon as a
# second client is attached.
if [ -n "$HERDR_ACTIVE_PANE_ID" ]; then
  set -- --pane "$HERDR_ACTIVE_PANE_ID"
else
  set -- --current
fi

layout=$(herdr pane layout "$@" 2>/dev/null)
tab=$(printf '%s' "$layout" |
  jq -r '[.. | objects | .tab_id? // empty] | first // empty')
[ -n "$tab" ] || exit 0
pane=${HERDR_ACTIVE_PANE_ID:-$(printf '%s' "$layout" |
  jq -r '[.. | objects | .focused_pane_id? // empty] | first // empty')}

# Compact json has no spaces, so a space splits the two fields.
"$bin/herdr-rpc" layout.export "{\"tab_id\":\"$tab\"}" |
  jq -r -L "$bin" --arg pane "$pane" --arg dir "$dir" 'include "layout"; equalize($pane; $dir)' |
  while read -r path ratio; do
    "$bin/herdr-rpc" layout.set_split_ratio \
      "{\"tab_id\":\"$tab\",\"path\":$path,\"ratio\":$ratio}" >/dev/null
  done
