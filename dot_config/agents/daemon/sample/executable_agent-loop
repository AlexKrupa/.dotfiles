#!/usr/bin/env bash
# A fake agent session of `sample`: one `watchd watch --session`, then `watchd wait --session` again
# and again, until a wait fails, the session has no watch, or a new watch replaces it. An agent
# with no plugin can use watchd in this way.
# Usage: agent-loop <worktree> <pid file> [<watch argument>...]
set -u

source "$(dirname "$0")/lib.sh"
worktree=$1
pid_file=$2
shift 2
echo "$$" >"$pid_file"
trap 'rm -f "$pid_file"' EXIT
cd "$worktree" || exit 1
echo "agent loop in $worktree: watchd watch --session $$ $*"
"$watchd" watch --session "$$" "$@" || { echo "watchd watch: exit $?, the agent loop stops"; exit 1; }
while true; do
  events=$("$watchd" wait --session "$$" --owner-pid "$$")
  code=$?
  [ -z "$events" ] || echo "$events"
  if [ "$code" != 0 ]; then
    echo "watchd wait: exit $code, the agent loop stops"
    exit 1
  fi
  if [ -z "$events" ]; then
    echo "watchd wait: no events and no error, the session has no watch, the agent loop stops"
    exit 0
  fi
  if jq -e 'select(.kind == "replaced")' <<<"$events" >/dev/null; then
    echo "watchd wait: a new watch replaced this one, the agent loop stops"
    exit 0
  fi
done
