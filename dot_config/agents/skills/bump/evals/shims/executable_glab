#!/usr/bin/env bash
# Fake glab for the bump evals. Answers from <repo>.host/ of the fixture and logs each call to
# <repo>.host/calls.log. A call that it does not know fails. `api graphql` comes only from the
# watch engine. It writes a different client_pid in the watch subscriptions of the repo, so the
# waiting watch.sh client stops with exit 3 ("replaced"). Then no run waits for the watch.
top=$(git rev-parse --show-toplevel)
host="$top.host"
echo "glab $*" >>"$host/calls.log"

replace_clients() {
  local file
  # shellcheck source=../../../../bin/watch-state.sh
  source "$HOME/.config/agents/bin/watch-state.sh"
  for file in "$WATCHD_DIR"/subs/*.json; do
    [[ -f $file && $(jq -r .repo "$file") == "$top" ]] || continue
    watch_sub_update "$(basename "$file" .json)" '.client_pid = 0'
  done
}

# The latest pipeline. After a push to the MR branch, it is a passed pipeline 901 for the new head.
pipeline() {
  local ref head
  ref=$(jq -r .ref "$host/pipeline.json")
  head=$(git ls-remote origin "refs/heads/$ref" | cut -f1)
  jq --arg head "$head" 'if .sha == $head or $head == "" then . else
    .id = 901 | .sha = $head | .status = "success" | .web_url |= sub("900$"; "901") end' \
    "$host/pipeline.json"
}
case "$1 $2" in
  "auth status") exit 0 ;;
  "repo view") echo '{"fullPath":"acme/app"}' ;;
  "mr view") cat "$host/mr.json" ;;
  "mr list") jq -s . "$host/mr.json" ;;
  "ci get") pipeline ;;
  "ci retry") echo "Retried job $3" ;;
  api*)
    case "$2" in
      graphql) replace_clients; exit 1 ;;
      */pipelines/900/jobs*) cat "$host/jobs.json" ;;
      */merge_requests/7/pipelines) pipeline | jq -s . ;;
      */test_report) echo '{"total_count":0,"test_suites":[]}' ;;
      */jobs/9001/trace) cat "$host/9001.log" ;;
      *) echo "fake glab: unknown api path $2" >&2; exit 1 ;;
    esac ;;
  *) echo "fake glab: unknown command $*" >&2; exit 1 ;;
esac
